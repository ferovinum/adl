module sys.types {

import adlc.config.python.*;

// For all types, provide both custom implementations and helper functions
// that simplify working with these types in Python

// Pair - Simple generic model with two fields
annotation Pair PythonCustomImplementation {
    ```python
    class Pair(pydantic.BaseModel, typing.Generic[T1, T2]):
      v1: T1
      v2: T2
    ```
    "helpers": "adl.sys.types.helpers"
};

// Either - Union type with left/right variants
annotation Either PythonCustomImplementation {
    ```python
    class Either_Left(pydantic.BaseModel, typing.Generic[T1]):
      left: T1

    class Either_Right(pydantic.BaseModel, typing.Generic[T2]):
      right: T2

    class Either(pydantic.RootModel[typing.Union[Either_Left[T1], Either_Right[T2]]], typing.Generic[T1, T2]):
      pass
    ```
    "helpers": "adl.sys.types.helpers"
};

// Maybe - Optional with structured serialization
annotation Maybe PythonCustomImplementation {
    ```python
    class Maybe_Nothing(pydantic.BaseModel):
      nothing: None

    class Maybe_Just(pydantic.BaseModel, typing.Generic[T]):
      just: T

    class Maybe(pydantic.RootModel[typing.Union[Maybe_Nothing, Maybe_Just[T]]], typing.Generic[T]):
      pass
    ```
    "helpers": "adl.sys.types.helpers"
};

// Result - Either specialized for success/error cases
annotation Result PythonCustomImplementation {
    ```python
    class Result_Ok(pydantic.BaseModel, typing.Generic[T]):
      ok: T

    class Result_Error(pydantic.BaseModel, typing.Generic[E]):
      error: E

    class Result(pydantic.RootModel[typing.Union[Result_Ok[T], Result_Error[E]]], typing.Generic[T, E]):
      pass
    ```
    "helpers": "adl.sys.types.helpers"
};

// MapEntry - Key-value pair for Map
annotation MapEntry PythonCustomImplementation {
    ```python
    class MapEntry(pydantic.BaseModel, typing.Generic[K, V]):
      key: K
      value: V
    ```
    "helpers": "adl.sys.types.helpers"
};

// Map - List of MapEntry objects
annotation Map PythonCustomImplementation {
    ```python
    class Map(list[MapEntry[K, V]], typing.Generic[K, V]):
      pass
    ```
    "helpers": "adl.sys.types.helpers"
};

// Set - List with unique values semantics
annotation Set PythonCustomImplementation {
    ```python
    class Set(list[T], typing.Generic[T]):
      pass
    ```
    "helpers": "adl.sys.types.helpers"
};

// Nullable - Use Python's Optional type
annotation Nullable PythonType "typing.Optional[T]";

}; 